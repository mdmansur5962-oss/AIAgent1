 */
class OfflineDemoResponder @Inject constructor() : ChatResponder {

    override fun reply(history: List<ChatMessage>, assistantName: String): Flow<String> = flow {
        val lastUser = history.lastOrNull { it.role == MessageRole.USER }?.content.orEmpty()
        val bangla = lastUser.any { it.code in 0x0980..0x09FF }
        val text = if (bangla) banglaText(assistantName) else englishText(assistantName)
        delay(450)
        text.chunked(3).forEach { chunk ->
            emit(chunk)
            delay(12)
        }
    }

    private fun englishText(name: String): String = """
I am **$name**, but no AI model is connected yet, so this is a *demo reply*.

Once you add an AI provider in the next steps, I will answer for real. Until then you can try the chat features:

- **Long-press** a message to copy, edit or delete it
- Tap the copy icon under my reply
- Use the refresh icon to ask again

Here is how code looks:

```python
def greet(name):
    return "Hello, " + name
```

> Tip: rename, pin or export this chat from the menu at the top.
""".trimIndent()

    private fun banglaText(name: String): String = """
আমি **$name**, কিন্তু এখনো কোনো AI মডেল সংযুক্ত নেই, তাই এটা একটা *নমুনা উত্তর*।

পরের ধাপে AI provider যোগ করলে আমি আসল উত্তর দেব। এখন চ্যাটের সুবিধাগুলো পরীক্ষা করে দেখতে পারেন:

- কোনো বার্তা **চেপে ধরলে** কপি, সম্পাদনা বা মোছা যায়
- আমার উত্তরের নিচের কপি আইকনে চাপুন
- আবার উত্তর চাইতে রিফ্রেশ আইকনে চাপুন

কোড এভাবে দেখায়:

```python
def greet(name):
    return "Hello, " + name
```

> টিপ: উপরের মেনু থেকে চ্যাটের নাম বদলানো, পিন করা বা export করা যায়।
""".trimIndent()
}

