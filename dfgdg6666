package com.aiagent.assistant.data.chat

import androidx.room.Dao
import androidx.room.Insert
import androidx.room.Query
import kotlinx.coroutines.flow.Flow

@Dao
interface ChatDao {

    // ───── chats ─────
    @Query(
        """
        SELECT c.id AS id, c.title AS title, c.pinned AS pinned, c.folderId AS folderId, c.updatedAt AS updatedAt,
            (SELECT m.content FROM messages m WHERE m.chatId = c.id ORDER BY m.id DESC LIMIT 1) AS lastMessage,
            (SELECT COUNT(*) FROM messages m WHERE m.chatId = c.id) AS messageCount
        FROM chats c
        ORDER BY c.pinned DESC, c.updatedAt DESC
        """
    )
    fun observeSummaries(): Flow<List<ChatSummaryRow>>

    @Query("SELECT * FROM chats WHERE id = :id")
    fun observeChat(id: Long): Flow<ChatEntity?>

    @Insert
    suspend fun insertChat(chat: ChatEntity): Long

    @Query("UPDATE chats SET title = :title WHERE id = :id")
    suspend fun renameChat(id: Long, title: String)

    @Query("UPDATE chats SET pinned = :pinned WHERE id = :id")
    suspend fun setPinned(id: Long, pinned: Boolean)

    @Query("UPDATE chats SET folderId = :folderId WHERE id = :id")
    suspend fun setFolder(id: Long, folderId: Long?)

    @Query("UPDATE chats SET updatedAt = :time WHERE id = :id")
    suspend fun touch(id: Long, time: Long)

    @Query("DELETE FROM chats WHERE id = :id")
    suspend fun deleteChat(id: Long)

    @Query("DELETE FROM chats")
    suspend fun deleteAllChats()

    // ───── messages ─────
    @Query("SELECT * FROM messages WHERE chatId = :chatId ORDER BY id ASC")
    fun observeMessages(chatId: Long): Flow<List<MessageEntity>>

    @Query("SELECT * FROM messages WHERE chatId = :chatId ORDER BY id ASC")
    suspend fun getMessages(chatId: Long): List<MessageEntity>

    @Query("SELECT DISTINCT chatId FROM messages WHERE content LIKE '%' || :query || '%'")
    suspend fun searchChatIds(query: String): List<Long>

    @Insert
    suspend fun insertMessage(message: MessageEntity): Long

    @Query("UPDATE messages SET content = :content WHERE id = :id")
    suspend fun updateMessageContent(id: Long, content: String)

    @Query("DELETE FROM messages WHERE id = :id")
    suspend fun deleteMessage(id: Long)

    @Query("DELETE FROM messages WHERE chatId = :chatId AND id > :messageId")
    suspend fun deleteMessagesAfter(chatId: Long, messageId: Long)

    // ───── folders ─────
    @Query("SELECT * FROM folders ORDER BY name COLLATE NOCASE ASC")
    fun observeFolders(): Flow<List<FolderEntity>>

    @Insert
    suspend fun insertFolder(folder: FolderEntity): Long

    @Query("UPDATE folders SET name = :name WHERE id = :id")
    suspend fun renameFolder(id: Long, name: String)

    @Query("DELETE FROM folders WHERE id = :id")
    suspend fun deleteFolder(id: Long)

    @Query("UPDATE chats SET folderId = NULL WHERE folderId = :folderId")
    suspend fun clearFolder(folderId: Long)
}

package com.aiagent.assistant.data.chat

import com.aiagent.assistant.domain.chat.Chat
import com.aiagent.assistant.domain.chat.ChatFolder
import com.aiagent.assistant.domain.chat.ChatMessage
import com.aiagent.assistant.domain.chat.ChatRepository
import com.aiagent.assistant.domain.chat.ChatSummary
import com.aiagent.assistant.domain.chat.MessageRole
import javax.inject.Inject
import javax.inject.Singleton
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map

private const val ROLE_USER = "user"
private const val ROLE_ASSISTANT = "assistant"

private fun ChatEntity.toDomain() = Chat(
    id = id,
    title = title,
    pinned = pinned,
    folderId = folderId,
    createdAt = createdAt,
    updatedAt = updatedAt
)

private fun MessageEntity.toDomain() = ChatMessage(
    id = id,
    chatId = chatId,
    role = if (role == ROLE_ASSISTANT) MessageRole.ASSISTANT else MessageRole.USER,
    content = content,
    createdAt = createdAt,
    isError = isError
)

private fun ChatSummaryRow.toDomain() = ChatSummary(
    id = id,
    title = title,
    pinned = pinned,
    folderId = folderId,
    updatedAt = updatedAt,
    lastMessage = lastMessage.orEmpty(),
    messageCount = messageCount
)

private fun FolderEntity.toDomain() = ChatFolder(id = id, name = name)

@Singleton
class ChatRepositoryImpl @Inject constructor(
    private val dao: ChatDao
) : ChatRepository {

    override fun observeSummaries(): Flow<List<ChatSummary>> =
        dao.observeSummaries().map { rows -> rows.map { it.toDomain() } }

    override fun observeFolders(): Flow<List<ChatFolder>> =
        dao.observeFolders().map { list -> list.map { it.toDomain() } }

    override fun observeChat(id: Long): Flow<Chat?> =
        dao.observeChat(id).map { it?.toDomain() }

    override fun observeMessages(chatId: Long): Flow<List<ChatMessage>> =
        dao.observeMessages(chatId).map { list -> list.map { it.toDomain() } }

    override suspend fun getMessages(chatId: Long): List<ChatMessage> =
        dao.getMessages(chatId).map { it.toDomain() }

    override suspend fun searchChatIds(query: String): List<Long> =
        dao.searchChatIds(query)

    override suspend fun createChat(title: String): Long {
        val now = System.currentTimeMillis()
        return dao.insertChat(ChatEntity(title = title, createdAt = now, updatedAt = now))
    }

    override suspend fun renameChat(id: Long, title: String) = dao.renameChat(id, title)

    override suspend fun setPinned(id: Long, pinned: Boolean) = dao.setPinned(id, pinned)

    override suspend fun setFolder(id: Long, folderId: Long?) = dao.setFolder(id, folderId)

    override suspend fun deleteChat(id: Long) = dao.deleteChat(id)

    override suspend fun deleteAll() = dao.deleteAllChats()

    override suspend fun addMessage(
        chatId: Long,
        role: MessageRole,
        content: String,
        isError: Boolean
    ): Long {
        val now = System.currentTimeMillis()
        val id = dao.insertMessage(
            MessageEntity(
                chatId = chatId,
                role = if (role == MessageRole.ASSISTANT) ROLE_ASSISTANT else ROLE_USER,
                content = content,
                createdAt = now,
                isError = isError
            )
        )
        dao.touch(chatId, now)
        return id
    }

    override suspend fun updateMessage(id: Long, content: String) = dao.updateMessageContent(id, content)

    override suspend fun deleteMessage(id: Long) = dao.deleteMessage(id)

    override suspend fun deleteMessagesAfter(chatId: Long, messageId: Long) =
        dao.deleteMessagesAfter(chatId, messageId)

    override suspend fun createFolder(name: String): Long =
        dao.insertFolder(FolderEntity(name = name, createdAt = System.currentTimeMillis()))

    override suspend fun renameFolder(id: Long, name: String) = dao.renameFolder(id, name)

    override suspend fun deleteFolder(id: Long) {
        dao.clearFolder(id)
        dao.deleteFolder(id)
    }
}

package com.aiagent.assistant.data.permission

import android.app.AlarmManager
import android.app.AppOpsManager
import android.app.NotificationManager
import android.content.ComponentName
import android.content.Context
import android.content.pm.PackageManager
import android.nfc.NfcAdapter
import android.os.Build
import android.os.PowerManager
import android.os.Process
import android.provider.Settings
import android.speech.SpeechRecognizer
import android.Manifest
import androidx.biometric.BiometricManager
import androidx.core.app.NotificationManagerCompat
import androidx.core.content.ContextCompat
import com.aiagent.assistant.domain.permission.PermissionCatalog
import com.aiagent.assistant.domain.permission.PermissionDef
import com.aiagent.assistant.domain.permission.PermissionId
import com.aiagent.assistant.domain.permission.PermissionKind
import com.aiagent.assistant.domain.permission.PermissionStatus
import com.aiagent.assistant.service.accessibility.AgentAccessibilityService
import dagger.hilt.android.qualifiers.ApplicationContext
import javax.inject.Inject
import javax.inject.Singleton

@Singleton
class PermissionChecker @Inject constructor(
    @ApplicationContext private val context: Context
) {
    private val sdk: Int get() = Build.VERSION.SDK_INT

    fun status(id: PermissionId): PermissionStatus = status(PermissionCatalog.byId(id))

    fun status(def: PermissionDef): PermissionStatus = when (def.id) {
        PermissionId.ACCESSIBILITY -> flag(isAccessibilityEnabled())
        PermissionId.OVERLAY -> flag(Settings.canDrawOverlays(context))
        PermissionId.NOTIFICATION_LISTENER,
        PermissionId.MEDIA_CONTROL -> flag(isNotificationListenerEnabled())
        PermissionId.BATTERY_OPTIMIZATION -> flag(isIgnoringBatteryOptimizations())
        PermissionId.ALARM_REMINDER -> flag(canScheduleExactAlarms())
        PermissionId.APP_USAGE -> flag(hasUsageAccess())
        PermissionId.INSTALL_UNKNOWN_APPS -> flag(context.packageManager.canRequestPackageInstalls())
        PermissionId.WRITE_SETTINGS -> flag(Settings.System.canWrite(context))
        PermissionId.DND_ACCESS -> flag(notificationManager().isNotificationPolicyAccessGranted)
        PermissionId.BIOMETRIC -> biometricStatus()
        PermissionId.SPEECH_RECOGNITION ->
            if (!SpeechRecognizer.isRecognitionAvailable(context)) {
                PermissionStatus.NOT_SUPPORTED
            } else {
                flag(allGranted(def.runtime(sdk)))
            }
        PermissionId.BACKGROUND_LOCATION ->
            if (sdk < 29) status(PermissionId.LOCATION) else flag(allGranted(def.runtime(sdk)))
        PermissionId.NFC ->
            if (NfcAdapter.getDefaultAdapter(context) == null) {
                PermissionStatus.NOT_SUPPORTED
            } else {
                flag(allGranted(def.normal))
            }
        else -> when (def.kind) {
            PermissionKind.RUNTIME -> flag(allGranted(def.runtime(sdk)))
            PermissionKind.NORMAL -> flag(allGranted(def.normal))
            PermissionKind.ON_DEMAND -> PermissionStatus.ON_DEMAND
            PermissionKind.INFO -> PermissionStatus.NOT_NEEDED
            PermissionKind.SPECIAL -> PermissionStatus.DENIED
        }
    }

    /** এখনো যে runtime permission-গুলো চাইতে হবে */
    fun runtimeToRequest(def: PermissionDef): List<String> {
        if (def.id == PermissionId.BACKGROUND_LOCATION &&
            !isGranted(Manifest.permission.ACCESS_FINE_LOCATION)
        ) {
            // আগে foreground location দরকার
            return PermissionCatalog.byId(PermissionId.LOCATION).runtime(sdk).filter { !isGranted(it) }
        }
        return def.runtime(sdk).filter { !isGranted(it) }
    }

    fun isGranted(permission: String): Boolean =
        ContextCompat.checkSelfPermission(context, permission) == PackageManager.PERMISSION_GRANTED

    /** Permission-টা AndroidManifest.xml-এ declare করা আছে কিনা */
    fun isDeclared(permission: String): Boolean = requestedPermissions().contains(permission)

    // ─────────── helpers ───────────

    private fun flag(granted: Boolean): PermissionStatus =
        if (granted) PermissionStatus.GRANTED else PermissionStatus.DENIED

    private fun allGranted(permissions: List<String>): Boolean = permissions.all { isGranted(it) }

    private fun notificationManager(): NotificationManager =
        context.getSystemService(NotificationManager::class.java)

    private fun isAccessibilityEnabled(): Boolean {
        val expected = ComponentName(context, AgentAccessibilityService::class.java)
        val enabled = Settings.Secure.getString(
            context.contentResolver,
            Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
        ) ?: return false
        return enabled.split(':').any { ComponentName.unflattenFromString(it) == expected }
    }

    private fun isNotificationListenerEnabled(): Boolean =
        NotificationManagerCompat.getEnabledListenerPackages(context).contains(context.packageName)

    private fun isIgnoringBatteryOptimizations(): Boolean {
        val pm = context.getSystemService(Context.POWER_SERVICE) as PowerManager
        return pm.isIgnoringBatteryOptimizations(context.packageName)
    }

    private fun canScheduleExactAlarms(): Boolean {
        if (sdk < 31) return true
        return context.getSystemService(AlarmManager::class.java).canScheduleExactAlarms()
    }

    @Suppress("DEPRECATION")
    private fun hasUsageAccess(): Boolean {
        val appOps = context.getSystemService(Context.APP_OPS_SERVICE) as AppOpsManager
        val mode = if (sdk >= 29) {
            appOps.unsafeCheckOpNoThrow(
                AppOpsManager.OPSTR_GET_USAGE_STATS,
                Process.myUid(),
                context.packageName
            )
        } else {
            appOps.checkOpNoThrow(
                AppOpsManager.OPSTR_GET_USAGE_STATS,
                Process.myUid(),
                context.packageName
            )
        }
        return mode == AppOpsManager.MODE_ALLOWED
    }

    private fun biometricStatus(): PermissionStatus =
        when (BiometricManager.from(context).canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_WEAK)) {
            BiometricManager.BIOMETRIC_SUCCESS -> PermissionStatus.GRANTED
            BiometricManager.BIOMETRIC_ERROR_NONE_ENROLLED -> PermissionStatus.DENIED
            else -> PermissionStatus.NOT_SUPPORTED
        }

    @Suppress("DEPRECATION")
    private fun requestedPermissions(): Array<String> {
        val pm = context.packageManager
        val info = if (sdk >= 33) {
            pm.getPackageInfo(
                context.packageName,
                PackageManager.PackageInfoFlags.of(PackageManager.GET_PERMISSIONS.toLong())
            )
        } else {
            pm.getPackageInfo(context.packageName, PackageManager.GET_PERMISSIONS)
        }
        return info.requestedPermissions ?: emptyArray()
    }
}

package com.aiagent.assistant.data.permission

import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Build
import android.provider.Settings
import androidx.biometric.BiometricManager
import com.aiagent.assistant.domain.permission.PermissionId

object PermissionIntents {

    fun appDetails(context: Context): Intent =
        Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:${context.packageName}"))

    /** যে permission Settings-এর আলাদা page-এ চালু করতে হয়, সেই page-এর Intent */
    fun settingsFor(context: Context, id: PermissionId): Intent {
        val pkgUri = Uri.parse("package:${context.packageName}")
        return when (id) {
            PermissionId.ACCESSIBILITY -> Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)
            PermissionId.OVERLAY -> Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, pkgUri)
            PermissionId.NOTIFICATION_LISTENER,
            PermissionId.MEDIA_CONTROL -> Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS)
            PermissionId.BATTERY_OPTIMIZATION ->
                Intent(Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, pkgUri)
            PermissionId.ALARM_REMINDER ->
                if (Build.VERSION.SDK_INT >= 31) {
                    Intent(Settings.ACTION_REQUEST_SCHEDULE_EXACT_ALARM, pkgUri)
                } else {
                    appDetails(context)
                }
            PermissionId.APP_USAGE -> Intent(Settings.ACTION_USAGE_ACCESS_SETTINGS)
            PermissionId.INSTALL_UNKNOWN_APPS -> Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, pkgUri)
            PermissionId.WRITE_SETTINGS -> Intent(Settings.ACTION_MANAGE_WRITE_SETTINGS, pkgUri)
            PermissionId.DND_ACCESS -> Intent(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS)
            PermissionId.BIOMETRIC ->
                if (Build.VERSION.SDK_INT >= 30) {
                    Intent(Settings.ACTION_BIOMETRIC_ENROLL).putExtra(
                        Settings.EXTRA_BIOMETRIC_AUTHENTICATORS_ALLOWED,
                        BiometricManager.Authenticators.BIOMETRIC_WEAK
                    )
                } else {
                    Intent(Settings.ACTION_SECURITY_SETTINGS)
                }
            else -> appDetails(context)
        }
    }
}

