/**
 * একটি বার্তা। চেপে ধরলে মেনু (কপি/সম্পাদনা/মোছা/আবার উত্তর)।
 * User-এর বার্তা ডানে gradient বাবলে, assistant-এর বাঁয়ে Markdown সহ।
 */
@Composable
fun MessageBubble(
    message: ChatMessage,
    canRegenerate: Boolean,
    onCopy: (String) -> Unit,
    onEdit: () -> Unit,
    onDelete: () -> Unit,
    onRegenerate: () -> Unit,
    modifier: Modifier = Modifier
) {
    val cs = MaterialTheme.colorScheme
    val isUser = message.role == MessageRole.USER
    val haptics = rememberAgentHaptics()
    var menuOpen by remember { mutableStateOf(false) }

    val shape = if (isUser) AgentExtraShapes.bubbleUser else AgentExtraShapes.bubbleAssistant
    val base = Modifier
        .widthIn(max = 340.dp)
        .clip(shape)
    val colored = when {
        isUser -> base.background(AgentDesign.colors.brand)
        message.isError -> base.background(cs.errorContainer)
        else -> base.background(cs.surfaceContainerHigh)
    }

    Column(
        modifier = modifier.fillMaxWidth(),
        horizontalAlignment = if (isUser) Alignment.End else Alignment.Start
    ) {
        Box {
            Box(
                modifier = colored
                    .pointerInput(message.id) {
                        detectTapGestures(
                            onLongPress = {
                                haptics.confirm()
                                menuOpen = true
                            }
                        )
                    }
                    .padding(horizontal = 16.dp, vertical = 12.dp)
            ) {
                if (isUser) {
                    Text(
                        text = message.content,
                        style = MaterialTheme.typography.bodyLarge,
                        color = Color.White
                    )
                } else {
                    MarkdownText(
                        markdown = message.content,
                        onCopyCode = onCopy,
                        textColor = if (message.isError) cs.onErrorContainer else cs.onSurface
                    )
                }
            }

            DropdownMenu(expanded = menuOpen, onDismissRequest = { menuOpen = false }) {
                DropdownMenuItem(
                    text = { Text("Copy · কপি") },
                    leadingIcon = { Icon(Icons.Rounded.ContentCopy, contentDescription = null) },
                    onClick = {
                        menuOpen = false
                        onCopy(message.content)
                    }
                )
                if (isUser) {
                    DropdownMenuItem(
                        text = { Text("Edit · সম্পাদনা") },
                        leadingIcon = { Icon(Icons.Rounded.Edit, contentDescription = null) },
                        onClick = {
                            menuOpen = false
                            onEdit()
                        }
                    )
                } else if (canRegenerate) {
                    DropdownMenuItem(
                        text = { Text("Regenerate · আবার উত্তর") },
                        leadingIcon = { Icon(Icons.Rounded.Refresh, contentDescription = null) },
                        onClick = {
                            menuOpen = false
                            onRegenerate()
                        }
                    )
                }
                DropdownMenuItem(
                    text = { Text("Delete · মুছুন") },
                    leadingIcon = { Icon(Icons.Rounded.Delete, contentDescription = null) },
                    onClick = {
                        menuOpen = false
                        onDelete()
                    }
                )
            }
        }

        if (!isUser) {
            Row(
                modifier = Modifier.padding(start = 4.dp),
                horizontalArrangement = Arrangement.spacedBy(0.dp)
            ) {
                IconButton(onClick = { onCopy(message.content) }, modifier = Modifier.size(36.dp)) {
                    Icon(
                        imageVector = Icons.Rounded.ContentCopy,
                        contentDescription = "Copy",
                        tint = cs.onSurfaceVariant,
                        modifier = Modifier.size(18.dp)
                    )
                }
                if (canRegenerate) {
                    IconButton(onClick = onRegenerate, modifier = Modifier.size(36.dp)) {
                        Icon(
                            imageVector = Icons.Rounded.Refresh,
                            contentDescription = "Regenerate",
                            tint = cs.onSurfaceVariant,
                            modifier = Modifier.size(18.dp)
                        )
                    }
                }
            }
        }
    }
}

/** উত্তর লেখা চলাকালীন আংশিক বাবল। এখনো লেখা না এলে তিনটি লাফানো বিন্দু। */
@Composable
fun StreamingBubble(
    text: String,
    onCopyCode: (String) -> Unit,
    modifier: Modifier = Modifier
) {
    val cs = MaterialTheme.colorScheme
    Row(modifier = modifier.fillMaxWidth(), horizontalArrangement = Arrangement.Start) {
        Box(
            modifier = Modifier
                .widthIn(max = 340.dp)
                .clip(AgentExtraShapes.bubbleAssistant)
                .background(cs.surfaceContainerHigh)
                .padding(horizontal = 16.dp, vertical = 12.dp)
        ) {
            if (text.isBlank()) {
                TypingDots(modifier = Modifier.padding(vertical = 4.dp))
            } else {
                MarkdownText(
                    markdown = text,
                    onCopyCode = onCopyCode,
                    textColor = cs.onSurface
                )
            }
        }
    }
}

package com.aiagent.assistant.presentation.chat

import androidx.lifecycle.SavedStateHandle
import androidx.lifecycle.viewModelScope
import com.aiagent.assistant.core.mvi.BaseViewModel
import com.aiagent.assistant.core.mvi.UiEffect
import com.aiagent.assistant.core.mvi.UiEvent
import com.aiagent.assistant.core.mvi.UiState
import com.aiagent.assistant.data.local.SettingsRepository
import com.aiagent.assistant.domain.chat.Chat
import com.aiagent.assistant.domain.chat.ChatExporter
import com.aiagent.assistant.domain.chat.ChatFolder
import com.aiagent.assistant.domain.chat.ChatMessage
import com.aiagent.assistant.domain.chat.ChatRepository
import com.aiagent.assistant.domain.chat.ChatResponder
import com.aiagent.assistant.domain.chat.MessageRole
import dagger.hilt.android.lifecycle.HiltViewModel
import javax.inject.Inject
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.ExperimentalCoroutinesApi
import kotlinx.coroutines.Job
import kotlinx.coroutines.NonCancellable
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.collect
import kotlinx.coroutines.flow.flatMapLatest
import kotlinx.coroutines.flow.flowOf
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

data class ChatUiState(
    val chatId: Long? = null,
    val title: String = "",
    val pinned: Boolean = false,
    val folderId: Long? = null,
    val messages: List<ChatMessage> = emptyList(),
    /** উত্তর লেখা চলছে: এখনো database-এ যায়নি এমন আংশিক লেখা */
    val streamingText: String? = null,
    val isGenerating: Boolean = false,
    val input: String = "",
    val editingMessageId: Long? = null,
    val folders: List<ChatFolder> = emptyList(),
    val appName: String = "MYRA",
    val assistantName: String = "MYRA"
) : UiState

sealed interface ChatEvent : UiEvent {
    data class InputChanged(val text: String) : ChatEvent
    data object Send : ChatEvent
    data class SendText(val text: String) : ChatEvent
    data object Stop : ChatEvent
    data object NewChat : ChatEvent
    data class StartEdit(val message: ChatMessage) : ChatEvent
    data object CancelEdit : ChatEvent
    data class DeleteMessage(val messageId: Long) : ChatEvent
    data object Regenerate : ChatEvent
    data class Rename(val title: String) : ChatEvent
    data object TogglePin : ChatEvent
    data class MoveToFolder(val folderId: Long?) : ChatEvent
    data object DeleteChat : ChatEvent
    data object CopyChat : ChatEvent
    data object ShareChat : ChatEvent
    data object SaveChat : ChatEvent
}

sealed interface ChatEffect : UiEffect {
    data class CopyText(val text: String) : ChatEffect
    data class ShareText(val title: String, val text: String) : ChatEffect
    data class SaveText(val fileName: String, val text: String) : ChatEffect
    data object ChatDeleted : ChatEffect
}

@OptIn(ExperimentalCoroutinesApi::class)
@HiltViewModel
class ChatViewModel @Inject constructor(
    savedStateHandle: SavedStateHandle,
    private val repository: ChatRepository,
    private val responder: ChatResponder,
    private val settingsRepository: SettingsRepository
) : BaseViewModel<ChatUiState, ChatEvent, ChatEffect>(ChatUiState()) {

    /** null = এখনো কোনো চ্যাট তৈরি হয়নি (প্রথম বার্তা পাঠালে তৈরি হবে) */
    private val chatIdFlow = MutableStateFlow(savedStateHandle.get<Long>("chatId")?.takeIf { it > 0 })

    private var generationJob: Job? = null

    init {
        viewModelScope.launch {
            chatIdFlow.collect { id -> setState { copy(chatId = id) } }
        }
        viewModelScope.launch {
            chatIdFlow
                .flatMapLatest { id ->
                    if (id == null) flowOf(emptyList<ChatMessage>()) else repository.observeMessages(id)
                }
                .collect { list -> setState { copy(messages = list) } }
        }
        viewModelScope.launch {
            chatIdFlow
                .flatMapLatest { id ->
                    if (id == null) flowOf<Chat?>(null) else repository.observeChat(id)
                }
                .collect { chat ->
                    setState {
                        copy(
                            title = chat?.title.orEmpty(),
                            pinned = chat?.pinned ?: false,
                            folderId = chat?.folderId
                        )
                    }
                }
        }
        viewModelScope.launch {
            repository.observeFolders().collect { list -> setState { copy(folders = list) } }
        }
        viewModelScope.launch {
            settingsRepository.settings.collect { s ->
                setState { copy(appName = s.appName, assistantName = s.assistantName) }
            }
        }
    }

    override fun onEvent(event: ChatEvent) {
        when (event) {
            is ChatEvent.InputChanged -> setState { copy(input = event.text) }
            ChatEvent.Send -> send(currentState.input)
            is ChatEvent.SendText -> send(event.text)
            ChatEvent.Stop -> generationJob?.cancel()
            ChatEvent.NewChat -> newChat()
            is ChatEvent.StartEdit -> setState {
                copy(editingMessageId = event.message.id, input = event.message.content)
            }
            ChatEvent.CancelEdit -> setState { copy(editingMessageId = null, input = "") }
            is ChatEvent.DeleteMessage -> viewModelScope.launch { repository.deleteMessage(event.messageId) }
            ChatEvent.Regenerate -> regenerate()
            is ChatEvent.Rename -> renameChat(event.title)
            ChatEvent.TogglePin -> togglePin()
            is ChatEvent.MoveToFolder -> moveToFolder(event.folderId)
            ChatEvent.DeleteChat -> deleteChat()
            ChatEvent.CopyChat -> sendEffect(ChatEffect.CopyText(exportText()))
            ChatEvent.ShareChat -> sendEffect(ChatEffect.ShareText(displayTitle(), exportText()))
            ChatEvent.SaveChat -> sendEffect(
                ChatEffect.SaveText(ChatExporter.toFileName(displayTitle()), exportText())
            )
        }
    }

    // ───────────── sending ─────────────

    private fun send(raw: String) {
        val text = raw.trim()
        if (text.isEmpty() || currentState.isGenerating) return
        val editingId = currentState.editingMessageId

        viewModelScope.launch {
            if (editingId != null) {
                val cid = chatIdFlow.value ?: return@launch
                repository.updateMessage(editingId, text)
                repository.deleteMessagesAfter(cid, editingId)
                setState { copy(input = "", editingMessageId = null) }
                generateReply(cid)
            } else {
                val cid = ensureChat(text)
                repository.addMessage(cid, MessageRole.USER, text)
                setState { copy(input = "") }
                generateReply(cid)
            }
        }
    }

    private suspend fun ensureChat(firstMessage: String): Long {
        val existing = chatIdFlow.value
        if (existing != null) return existing
        val title = firstMessage.lineSequence().firstOrNull().orEmpty().trim().take(40)
        val id = repository.createChat(title)
        chatIdFlow.value = id
        return id
    }

    private fun generateReply(chatId: Long) {
        generationJob?.cancel()
        generationJob = viewModelScope.launch {
            setState { copy(isGenerating = true, streamingText = "") }
            val buffer = StringBuilder()
            try {
                val history = repository.getMessages(chatId)
                responder.reply(history, currentState.assistantName).collect { chunk ->
                    buffer.append(chunk)
                    setState { copy(streamingText = buffer.toString()) }
                }
                repository.addMessage(chatId, MessageRole.ASSISTANT, buffer.toString())
            } catch (e: CancellationException) {
                // থামালে এ পর্যন্ত যা এসেছে তা রেখে দেয়
                if (buffer.isNotEmpty()) {
                    withContext(NonCancellable) {
                        repository.addMessage(chatId, MessageRole.ASSISTANT, buffer.toString())
                    }
                }
                throw e
            } catch (e: Exception) {
                repository.addMessage(
                    chatId,
                    MessageRole.ASSISTANT,
                    "Something went wrong · কিছু একটা ভুল হয়েছে\n\n" + (e.message ?: ""),
                    isError = true
                )
            } finally {
                setState { copy(isGenerating = false, streamingText = null) }
            }
        }
    }

    private fun regenerate() {
        val cid = chatIdFlow.value ?: return
        if (currentState.isGenerating) return
        val lastAssistant = currentState.messages.lastOrNull { it.role == MessageRole.ASSISTANT } ?: return
        viewModelScope.launch {
            repository.deleteMessage(lastAssistant.id)
            generateReply(cid)
        }
    }

    // ───────────── chat actions ─────────────

    private fun newChat() {
        generationJob?.cancel()
        chatIdFlow.value = null
        setState { copy(input = "", editingMessageId = null, streamingText = null, isGenerating = false) }
    }

    private fun renameChat(title: String) {
        val id = chatIdFlow.value ?: return
        val clean = title.trim().take(60)
        if (clean.isEmpty()) return
        viewModelScope.launch { repository.renameChat(id, clean) }
    }

    private fun togglePin() {
        val id = chatIdFlow.value ?: return
        val pinned = currentState.pinned
        viewModelScope.launch { repository.setPinned(id, !pinned) }
    }

    private fun moveToFolder(folderId: Long?) {
        val id = chatIdFlow.value ?: return
        viewModelScope.launch { repository.setFolder(id, folderId) }
    }

    private fun deleteChat() {
        val id = chatIdFlow.value ?: return
        generationJob?.cancel()
        viewModelScope.launch {
            chatIdFlow.value = null
            repository.deleteChat(id)
            setState { copy(input = "", editingMessageId = null, streamingText = null, isGenerating = false) }
            sendEffect(ChatEffect.ChatDeleted)
        }
    }

    private fun displayTitle(): String = currentState.title.ifBlank { "Chat" }

    private fun exportText(): String = ChatExporter.toMarkdown(
        title = displayTitle(),
        messages = currentState.messages,
        appName = currentState.appName,
        assistantName = currentState.assistantName
    )
}

package com.aiagent.assistant.presentation.chat.markdown

import androidx.compose.ui.text.AnnotatedString
import androidx.compose.ui.text.SpanStyle
import androidx.compose.ui.text.buildAnnotatedString
import androidx.compose.ui.text.font.FontStyle
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextDecoration
import androidx.compose.ui.text.withStyle

sealed interface MdBlock {
    data class Heading(val level: Int, val text: String) : MdBlock
    data class Paragraph(val text: String) : MdBlock
    data class Bullet(val text: String, val indent: Int) : MdBlock
    data class Numbered(val number: String, val text: String, val indent: Int) : MdBlock
    data class Quote(val text: String) : MdBlock
    data class Code(val language: String, val code: String) : MdBlock
    data object Rule : MdBlock
}

/**
 * ছোট নিজস্ব Markdown parser (বাইরের library ছাড়া)।
 * সমর্থিত: # শিরোনাম, **bold**, *italic*, ~~strike~~, `code`, [link](url), তালিকা (- ও 1.),
 * > quote, ``` code block ```, --- রেখা। (টেবিল সাধারণ লেখা হিসেবে দেখায়।)
 */
object MarkdownParser {

    private val headingRe = Regex("^(#{1,6})\\s+(.*)$")
    private val bulletRe = Regex("^(\\s*)[-*+•]\\s+(.*)$")
    private val numberedRe = Regex("^(\\s*)(\\d{1,3})[.)]\\s+(.*)$")
    private val quoteRe = Regex("^>\\s?(.*)$")
    private val ruleRe = Regex("^\\s*([-*_])(\\s*\\1){2,}\\s*$")

    fun parseBlocks(markdown: String): List<MdBlock> {
        val blocks = mutableListOf<MdBlock>()
        val lines = markdown.replace("\r\n", "\n").split("\n")
        val para = StringBuilder()

        fun flushParagraph() {
            if (para.isNotEmpty()) {
                blocks.add(MdBlock.Paragraph(para.toString().trimEnd()))
                para.clear()
            }
        }

        var i = 0
        while (i < lines.size) {
            val line = lines[i]
            val trimmed = line.trimStart()

            if (trimmed.startsWith("```")) {
                flushParagraph()
                val language = trimmed.removePrefix("```").trim()
                val code = StringBuilder()
                var first = true
                i++
                // শেষ fence না এলেও (streaming চলাকালীন) বাকি অংশ code হিসেবে দেখাবে
                while (i < lines.size && !lines[i].trimStart().startsWith("```")) {
                    if (!first) code.append('\n')
                    code.append(lines[i])
                    first = false
                    i++
                }
                blocks.add(MdBlock.Code(language, code.toString()))
                i++
                continue
            }

            val heading = headingRe.matchEntire(line)
            val bullet = bulletRe.matchEntire(line)
            val numbered = numberedRe.matchEntire(line)
            val quote = quoteRe.matchEntire(line)

            when {
                line.isBlank() -> flushParagraph()
                ruleRe.matches(line) -> {
                    flushParagraph()
                    blocks.add(MdBlock.Rule)
                }
                heading != null -> {
                    flushParagraph()
                    blocks.add(MdBlock.Heading(heading.groupValues[1].length, heading.groupValues[2].trim()))
                }
                bullet != null -> {
                    flushParagraph()
                    blocks.add(MdBlock.Bullet(bullet.groupValues[2], bullet.groupValues[1].length / 2))
                }
                numbered != null -> {
                    flushParagraph()
                    blocks.add(
                        MdBlock.Numbered(
                            number = numbered.groupValues[2],
                            text = numbered.groupValues[3],
                            indent = numbered.groupValues[1].length / 2
                        )
                    )
                }
                quote != null -> {
                    flushParagraph()
                    val last = blocks.lastOrNull()
                    val text = quote.groupValues[1]
                    if (last is MdBlock.Quote) {
                        blocks[blocks.lastIndex] = last.copy(text = last.text + "\n" + text)
                    } else {
                        blocks.add(MdBlock.Quote(text))
                    }
                }
                else -> {
                    if (para.isNotEmpty()) para.append('\n')
                    para.append(line)
                }
            }
            i++
        }
        flushParagraph()
        return blocks
    }

    fun parseInline(text: String, codeStyle: SpanStyle, linkStyle: SpanStyle): AnnotatedString =
        buildAnnotatedString { appendInline(text, codeStyle, linkStyle) }

    private fun AnnotatedString.Builder.appendInline(text: String, codeStyle: SpanStyle, linkStyle: SpanStyle) {
        var i = 0
        val n = text.length
        while (i < n) {
            val c = text[i]
            when {
                c == '`' -> {
                    val end = text.indexOf('`', i + 1)
                    if (end > i) {
                        withStyle(codeStyle) { append(text.substring(i + 1, end)) }
                        i = end + 1
                    } else {
                        append(c)
                        i++
                    }
                }
                text.startsWith("**", i) || text.startsWith("__", i) -> {
                    val marker = text.substring(i, i + 2)
                    val end = text.indexOf(marker, i + 2)
                    if (end > i + 2) {
                        withStyle(SpanStyle(fontWeight = FontWeight.Bold)) {
                            appendInline(text.substring(i + 2, end), codeStyle, linkStyle)
                        }
                        i = end + 2
                    } else {
                        append(c)
                        i++
                    }
                }
                text.startsWith("~~", i) -> {
                    val end = text.indexOf("~~", i + 2)
                    if (end > i + 2) {
                        withStyle(SpanStyle(textDecoration = TextDecoration.LineThrough)) {
                            appendInline(text.substring(i + 2, end), codeStyle, linkStyle)
                        }
                        i = end + 2
                    } else {
                        append(c)
                        i++
                    }
                }
                (c == '*' || c == '_') && isItalicStart(text, i) -> {
                    val end = findItalicEnd(text, i + 1, c)
                    if (end > i + 1) {
                        withStyle(SpanStyle(fontStyle = FontStyle.Italic)) {
                            appendInline(text.substring(i + 1, end), codeStyle, linkStyle)
                        }
                        i = end + 1
                    } else {
                        append(c)
                        i++
                    }
                }
                c == '[' -> {
                    val close = text.indexOf("](", i + 1)
                    val paren = if (close > 0) text.indexOf(')', close + 2) else -1
                    if (close > i && paren > close) {
                        withStyle(linkStyle) { append(text.substring(i + 1, close)) }
                        i = paren + 1
                    } else {
                        append(c)
                        i++
                    }
                }
                else -> {
                    append(c)
                    i++
                }
            }
        }
    }

    private fun isItalicStart(text: String, i: Int): Boolean {
        if (i + 1 >= text.length) return false
        if (text[i + 1].isWhitespace()) return false
        if (text[i] == '_' && i > 0 && text[i - 1].isLetterOrDigit()) return false
        return true
    }

    private fun findItalicEnd(text: String, from: Int, marker: Char): Int {
        var j = from
        while (j < text.length) {
            if (text[j] == marker && !text[j - 1].isWhitespace()) {
                val nextOk = marker == '*' || j + 1 >= text.length || !text[j + 1].isLetterOrDigit()
                if (nextOk) return j
            }
            j++
        }
        return -1
    }
}

