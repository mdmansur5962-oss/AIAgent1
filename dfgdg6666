/** Assistant-এর উত্তর Markdown হিসেবে সাজিয়ে দেখায়। Code block-এ নিজস্ব Copy বোতাম আছে। */
@Composable
fun MarkdownText(
    markdown: String,
    onCopyCode: (String) -> Unit,
    modifier: Modifier = Modifier,
    textColor: Color = LocalContentColor.current
) {
    val cs = MaterialTheme.colorScheme
    val blocks = remember(markdown) { MarkdownParser.parseBlocks(markdown) }
    val codeStyle = SpanStyle(
        fontFamily = FontFamily.Monospace,
        background = cs.primary.copy(alpha = 0.18f),
        color = textColor
    )
    val linkStyle = SpanStyle(
        color = cs.secondary,
        textDecoration = TextDecoration.Underline
    )

    Column(
        modifier = modifier,
        verticalArrangement = Arrangement.spacedBy(8.dp)
    ) {
        blocks.forEach { block ->
            when (block) {
                is MdBlock.Heading -> {
                    val base = when (block.level) {
                        1 -> MaterialTheme.typography.headlineSmall
                        2 -> MaterialTheme.typography.titleLarge
                        else -> MaterialTheme.typography.titleMedium
                    }
                    Text(
                        text = MarkdownParser.parseInline(block.text, codeStyle, linkStyle),
                        style = base.copy(fontWeight = FontWeight.Bold),
                        color = textColor
                    )
                }
                is MdBlock.Paragraph -> Text(
                    text = MarkdownParser.parseInline(block.text, codeStyle, linkStyle),
                    style = MaterialTheme.typography.bodyLarge,
                    color = textColor
                )
                is MdBlock.Bullet -> Row(
                    modifier = Modifier.padding(start = (block.indent * 16).dp),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text(text = "•", style = MaterialTheme.typography.bodyLarge, color = textColor)
                    Text(
                        text = MarkdownParser.parseInline(block.text, codeStyle, linkStyle),
                        style = MaterialTheme.typography.bodyLarge,
                        color = textColor,
                        modifier = Modifier.weight(1f)
                    )
                }
                is MdBlock.Numbered -> Row(
                    modifier = Modifier.padding(start = (block.indent * 16).dp),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text(text = block.number + ".", style = MaterialTheme.typography.bodyLarge, color = textColor)
                    Text(
                        text = MarkdownParser.parseInline(block.text, codeStyle, linkStyle),
                        style = MaterialTheme.typography.bodyLarge,
                        color = textColor,
                        modifier = Modifier.weight(1f)
                    )
                }
                is MdBlock.Quote -> Row(
                    modifier = Modifier.height(IntrinsicSize.Min),
                    horizontalArrangement = Arrangement.spacedBy(10.dp)
                ) {
                    Box(
                        modifier = Modifier
                            .width(3.dp)
                            .fillMaxHeight()
                            .clip(RoundedCornerShape(2.dp))
                            .background(cs.primary)
                    )
                    Text(
                        text = MarkdownParser.parseInline(block.text, codeStyle, linkStyle),
                        style = MaterialTheme.typography.bodyLarge.copy(fontStyle = FontStyle.Italic),
                        color = textColor.copy(alpha = 0.85f),
                        modifier = Modifier.weight(1f)
                    )
                }
                is MdBlock.Code -> CodeBlock(
                    language = block.language,
                    code = block.code,
                    onCopy = onCopyCode
                )
                MdBlock.Rule -> HorizontalDivider(color = cs.outline.copy(alpha = 0.4f))
            }
        }
    }
}

@Composable
private fun CodeBlock(
    language: String,
    code: String,
    onCopy: (String) -> Unit
) {
    val cs = MaterialTheme.colorScheme
    val shape = RoundedCornerShape(14.dp)

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .clip(shape)
            .background(cs.surfaceContainerLowest)
            .border(1.dp, cs.outline.copy(alpha = 0.3f), shape)
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .background(cs.surfaceContainerHigh)
                .padding(start = 12.dp, end = 4.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(
                text = language.ifBlank { "code" },
                style = MaterialTheme.typography.labelMedium,
                color = cs.onSurfaceVariant,
                modifier = Modifier.weight(1f)
            )
            TextButton(
                onClick = { onCopy(code) },
                contentPadding = PaddingValues(horizontal = 10.dp, vertical = 4.dp)
            ) {
                Icon(
                    imageVector = Icons.Rounded.ContentCopy,
                    contentDescription = null,
                    modifier = Modifier.size(16.dp),
                    tint = cs.secondary
                )
                Spacer(modifier = Modifier.width(6.dp))
                Text(text = "Copy · কপি", color = cs.secondary, style = MaterialTheme.typography.labelMedium)
            }
        }
        Text(
            text = code,
            style = TextStyle(
                fontFamily = FontFamily.Monospace,
                fontSize = 13.sp,
                lineHeight = 20.sp
            ),
            color = cs.onSurface,
            modifier = Modifier
                .horizontalScroll(rememberScrollState())
                .padding(12.dp)
        )
    }
}

package com.aiagent.assistant.presentation.settings

import android.content.Context
import android.speech.tts.TextToSpeech
import java.util.Locale

enum class SpeakResult { OK, NOT_READY, LANGUAGE_MISSING }

/** Voice settings পেজে নমুনা শোনানোর ছোট TextToSpeech helper (Step 9-এ পূর্ণ voice engine আসবে) */
class VoicePreview(context: Context) {

    @Volatile
    private var ready = false
    private var tts: TextToSpeech? = null

    init {
        tts = TextToSpeech(context.applicationContext) { status ->
            ready = status == TextToSpeech.SUCCESS
        }
    }

    fun speak(text: String, locale: Locale, speed: Float, pitch: Float): SpeakResult {
        val engine = tts ?: return SpeakResult.NOT_READY
        if (!ready) return SpeakResult.NOT_READY
        val langResult = engine.setLanguage(locale)
        if (langResult == TextToSpeech.LANG_MISSING_DATA || langResult == TextToSpeech.LANG_NOT_SUPPORTED) {
            return SpeakResult.LANGUAGE_MISSING
        }
        engine.setSpeechRate(speed)
        engine.setPitch(pitch)
        engine.speak(text, TextToSpeech.QUEUE_FLUSH, null, "preview")
        return SpeakResult.OK
    }

    fun shutdown() {
        tts?.stop()
        tts?.shutdown()
        tts = null
    }
}

